	"documentnotes": {
		"note": [
			{
				"text": "\n            An origin validation error vulnerability [CWE-346] in FortiClient Mac, FortiClient Windows, and FortiClient Windows PAM may allow an unauthorized remote attacker to execute unauthorized code or commands. Successful exploitation requires interaction with the victim.\n        ",
				"title": "Summary",
				"type": "Summary",
				"ordinal": "1"
			},
