	"documentnotes": {
		"note": [
			{
				"text": "\n            An out-of-bounds read/write vulnerability (CWE-125/CWE-787) in FortiOS, FortiSASE, kernel may allow an unauthenticated attacker to execute arbitrary code or command via crafted packets.\n        ",
				"title": "Summary",
				"type": "Summary",
				"ordinal": "1"
			},
			{
				"text": "\n            None\n        ",
				"title": "Description",
				"type": "General",
				"ordinal": "2"
			},
			{
				"text": "\n            Execute unauthorized code or commands\n        ",
